# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Node (root security-rule tests and Cloud Functions). Matched without the
# trailing slash so a symlinked node_modules is ignored too.
node_modules

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing material must stay out of source control
*.jks

# Axis Zero: service-account private keys. functions/.gitignore already has a
# local rule; this root rule is defence in depth so a key dropped anywhere in
# the tree (a backup folder, a copied fixture) is ignored too. Use Application
# Default Credentials / GOOGLE_APPLICATION_CREDENTIALS outside the repo.
serviceAccount*.json
service-account*.json

# Local toolchain (portable JDK for the rules emulator)
.tooling/

# Kotlin compiler session artifacts (generated per machine, never source)
android/.kotlin/
*.salive
