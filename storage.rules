rules_version = '2';

// Storage is deliberately an authenticated-data store.  In particular, do not
// add a catch-all rule here: every supported object name is matched below.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isAudio() {
      return request.resource.contentType.matches('audio/(aac|mpeg|mp4|ogg|wav|x-m4a)');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/(mp4|webm|quicktime)');
    }

    function imageUpload(maxBytes) {
      return isImage() && request.resource.size <= maxBytes;
    }

    // A Fan Work PDF. The ceiling is 50 MB and the type must be exactly
    // application/pdf, because a mislabelled payload here would be served
    // straight into the in-app reader. Reads never come through this rule: a
    // signed V4 read URL is minted by `fanWorksStorage.js` instead, so this
    // match only ever authorizes a write by the owning creator.
    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }

    // Chat paths historically use a .jpg suffix even for audio and video.
    // The suffix is therefore not used as a security signal; the declared MIME
    // type and a media-type-specific size ceiling are enforced instead.
    function chatMediaUpload() {
      return (isImage() && request.resource.size <= 10 * 1024 * 1024) ||
          (isAudio() && request.resource.size <= 25 * 1024 * 1024) ||
          (isVideo() && request.resource.size <= 100 * 1024 * 1024);
    }

    function groupDocument(groupId) {
      return firestore.get(
          /databases/(default)/documents/groups/$(groupId));
    }

    // founderId is the field written by the Flutter app. ownerId is retained
    // only for existing groups created by older server/client code.
    function isGroupOwner(groupId) {
      return signedIn() &&
          firestore.exists(/databases/(default)/documents/groups/$(groupId)) &&
          (groupDocument(groupId).data.founderId == request.auth.uid ||
           ('ownerId' in groupDocument(groupId).data &&
            groupDocument(groupId).data.ownerId == request.auth.uid));
    }

    function isGroupMember(groupId) {
      return signedIn() &&
          firestore.exists(
            /databases/(default)/documents/groups/$(groupId)) &&
          firestore.exists(
            /databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isPrivateParticipant(chatId) {
      return signedIn() &&
          firestore.exists(
            /databases/(default)/documents/privateChats/$(chatId)) &&
          (request.auth.uid in firestore.get(
            /databases/(default)/documents/privateChats/$(chatId))
              .data.get('participantIds', []) ||
           firestore.get(
            /databases/(default)/documents/privateChats/$(chatId)).data.userA ==
            request.auth.uid ||
           firestore.get(
            /databases/(default)/documents/privateChats/$(chatId)).data.userB ==
            request.auth.uid);
    }

    function publicProfileAvatar(userId) {
      return signedIn() &&
          firestore.exists(/databases/(default)/documents/users/$(userId)) &&
          firestore.get(/databases/(default)/documents/users/$(userId))
            .data.get('profileVisibility', 'public') == 'public';
    }

    // StorageService writes this value for legacy chat uploads. It prevents a
    // group member/participant from replacing or deleting another sender's
    // object even though the object name itself has no UID.
    function isNewUploader() {
      return request.resource.metadata.uploadedBy == request.auth.uid;
    }

    function isExistingUploader() {
      return resource.metadata.uploadedBy == request.auth.uid;
    }

    function editUploadCeiling() {
      return 100 * 1024 * 1024;
    }

    // §15.18 — a takedown must revoke the media, not just the document. The
    // Storage path is `edits/{creatorId}/{fileName}` and
    // `edits-processed/{creatorId}/{fileName}`, so the Reel id cannot be
    // recovered from the filename with the string operations rules expose.
    // The server therefore maintains one receipt document per stored object at
    // `edits/{creatorId}/media/{fileName}`, and publication flips it on while a
    // takedown flips it off. The receipt is server-written and client-denied,
    // so it cannot be forged from the app.
    function editMediaVisible(userId, fileName) {
      return firestore.exists(/databases/(default)/documents/edits/$(userId)/media/$(fileName)) &&
        firestore.get(/databases/(default)/documents/edits/$(userId)/media/$(fileName)).data.visible == true;
    }

    function isEditVideoName(fileName) {
      return fileName.matches('(v|[a-zA-Z0-9_-]+)\\.mp4');
    }

    function isEditThumbnailName(fileName) {
      return fileName.matches('t_[a-zA-Z0-9_-]+\\.jpg');
    }

    function isEditProcessedName(fileName) {
      return fileName.matches('([a-zA-Z0-9_-]+)(_[a-zA-Z0-9]+)?\\.mp4') ||
        fileName.matches('t_[a-zA-Z0-9_-]+\\.jpg');
    }

    // Legacy profile path used by StorageService.
    match /avatars/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() &&
          fileName == request.auth.uid + '.jpg' &&
          imageUpload(5 * 1024 * 1024);
      allow delete: if signedIn() && fileName == request.auth.uid + '.jpg';
    }

    // Current documented profile and sticker paths.
    match /users/{userId}/avatar.jpg {
      allow read: if signedIn() &&
          (request.auth.uid == userId || publicProfileAvatar(userId));
      allow create, update: if signedIn() && request.auth.uid == userId &&
          imageUpload(5 * 1024 * 1024);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    // Profile cover photo. Mirrors the avatar privacy gate: private profiles
    // are only readable by their owner (spec §18.3).
    match /users/{userId}/cover.jpg {
      allow read: if signedIn() &&
          (request.auth.uid == userId || publicProfileAvatar(userId));
      allow create, update: if signedIn() && request.auth.uid == userId &&
          imageUpload(10 * 1024 * 1024);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/stickers/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId &&
          fileName.matches('.*\\.png') &&
          request.resource.contentType == 'image/png' &&
          request.resource.size <= 5 * 1024 * 1024;
      allow delete: if signedIn() && request.auth.uid == userId &&
          fileName.matches('.*\\.png');
    }

    // Staging for group avatar/cover before the group document exists.
    // Owner-only; download URLs (token) are persisted after a successful put.
    match /users/{userId}/group_staging/{fileName} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn() && request.auth.uid == userId &&
          imageUpload(10 * 1024 * 1024);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /groups/{groupId}/group_image.jpg {
      allow read: if signedIn();
      allow create, update: if signedIn() && isGroupOwner(groupId) &&
          imageUpload(10 * 1024 * 1024);
      allow delete: if signedIn() && isGroupOwner(groupId);
    }

    match /groups/{groupId}/chat_background.jpg {
      allow read: if signedIn();
      allow create, update: if signedIn() && isGroupOwner(groupId) &&
          imageUpload(10 * 1024 * 1024);
      allow delete: if signedIn() && isGroupOwner(groupId);
    }

    match /groups/{groupId}/characters/{fileName} {
      allow read: if signedIn() && isGroupMember(groupId);
      allow create, update: if signedIn() &&
          fileName == request.auth.uid + '.jpg' &&
          isGroupMember(groupId) && imageUpload(10 * 1024 * 1024);
      allow delete: if signedIn() &&
          fileName == request.auth.uid + '.jpg' &&
          isGroupMember(groupId);
    }

    // Legacy chat media remains readable for existing messages, but new writes
    // use an uploader UID segment so ownership is enforced independently of
    // mutable metadata.
    match /groups/{groupId}/chat/{fileName} {
      allow read: if signedIn() && isGroupMember(groupId);
      allow write: if false;
    }

    match /groups/{groupId}/chat/{uploaderId}/{fileName} {
      allow read: if signedIn() && isGroupMember(groupId);
      allow create, update: if signedIn() &&
          request.auth.uid == uploaderId &&
          isGroupMember(groupId) &&
          isNewUploader() && chatMediaUpload();
      allow delete: if signedIn() &&
          request.auth.uid == uploaderId &&
          isGroupMember(groupId);
    }

    // Reserved/current structured group-media and voice names.
    match /groups/{groupId}/media/{fileName} {
      allow read: if signedIn() && isGroupMember(groupId);
      allow create: if resource == null &&
          signedIn() && isGroupMember(groupId) &&
          isNewUploader() && chatMediaUpload() &&
          fileName.matches('.*_original\\.[a-zA-Z0-9]+');
      // putData/putFile uses a resumable protocol that requires UPDATE after
      // CREATE (same root cause as /edits above). Denying update produced
      // "User is not authorized to perform the desired action" on every real
      // group-media upload. The object stays effectively immutable: only the
      // original uploader may resume/overwrite it, and they may not reassign
      // `uploadedBy` to another uid. Thumb/medium variants are written only by
      // the Admin SDK media pipeline.
      allow update: if signedIn() && isGroupMember(groupId) &&
          isExistingUploader() && isNewUploader() && chatMediaUpload() &&
          fileName.matches('.*_original\\.[a-zA-Z0-9]+');
      allow delete: if signedIn() && isGroupMember(groupId) &&
          isExistingUploader() &&
          fileName.matches('.*_original\\.[a-zA-Z0-9]+');
    }

    match /groups/{groupId}/voices/{fileName} {
      allow read: if signedIn() && isGroupMember(groupId);
      allow create: if signedIn() && isGroupMember(groupId) &&
          isNewUploader() &&
          fileName.matches('.*\\.m4a') &&
          ((request.resource.contentType == 'audio/mp4' ||
              request.resource.contentType == 'audio/x-m4a') &&
              request.resource.size <= 25 * 1024 * 1024);
      allow update: if signedIn() && isGroupMember(groupId) &&
          isExistingUploader() && isNewUploader() &&
          fileName.matches('.*\\.m4a') &&
          ((request.resource.contentType == 'audio/mp4' ||
              request.resource.contentType == 'audio/x-m4a') &&
              request.resource.size <= 25 * 1024 * 1024);
      allow delete: if signedIn() && isGroupMember(groupId) &&
          isExistingUploader();
    }

    // Legacy private-chat media remains readable for existing messages only.
    match /private_chats/{chatId}/{fileName} {
      allow read: if signedIn() && isPrivateParticipant(chatId);
      allow write: if false;
    }

    match /private_chats/{chatId}/{uploaderId}/{fileName} {
      allow read: if signedIn() && isPrivateParticipant(chatId);
      allow create, update: if signedIn() &&
          request.auth.uid == uploaderId &&
          isPrivateParticipant(chatId) &&
          isNewUploader() && chatMediaUpload();
      allow delete: if signedIn() &&
          request.auth.uid == uploaderId &&
          isPrivateParticipant(chatId);
    }

    match /privateChats/{chatId}/media/{fileName} {
      allow read: if signedIn() && isPrivateParticipant(chatId);
      allow create: if resource == null &&
          signedIn() && isPrivateParticipant(chatId) &&
          isNewUploader() && chatMediaUpload() &&
          fileName.matches('.*_original\\.[a-zA-Z0-9]+');
      // Resumable putData needs UPDATE after CREATE; restricted to the
      // original uploader so one participant cannot replace another's media.
      allow update: if signedIn() && isPrivateParticipant(chatId) &&
          isExistingUploader() && isNewUploader() && chatMediaUpload() &&
          fileName.matches('.*_original\\.[a-zA-Z0-9]+');
      allow delete: if signedIn() && isPrivateParticipant(chatId) &&
          isExistingUploader() &&
          fileName.matches('.*_original\\.[a-zA-Z0-9]+');
    }

    match /privateChats/{chatId}/voices/{fileName} {
      allow read: if signedIn() && isPrivateParticipant(chatId);
      allow create: if signedIn() && isPrivateParticipant(chatId) &&
          isNewUploader() &&
          fileName.matches('.*\\.m4a') &&
          ((request.resource.contentType == 'audio/mp4' ||
              request.resource.contentType == 'audio/x-m4a') &&
              request.resource.size <= 25 * 1024 * 1024);
      allow update: if signedIn() && isPrivateParticipant(chatId) &&
          isExistingUploader() && isNewUploader() &&
          fileName.matches('.*\\.m4a') &&
          ((request.resource.contentType == 'audio/mp4' ||
              request.resource.contentType == 'audio/x-m4a') &&
              request.resource.size <= 25 * 1024 * 1024);
      allow delete: if signedIn() && isPrivateParticipant(chatId) &&
          isExistingUploader();
    }

    match /edits/{userId}/{fileName} {
      // The creator reads their own source (retry, re-upload, draft recovery);
      // everyone else only sees objects the server has published.
      allow read: if signedIn() &&
          (isEditVideoName(fileName) || isEditThumbnailName(fileName)) &&
          (request.auth.uid == userId || editMediaVisible(userId, fileName));
      // putData/putFile uses a resumable protocol that requires UPDATE
      // after CREATE. Denying update produced "User is not authorized
      // to perform the desired action" on every real video upload.
      // Some clients also append codec parameters to contentType
      // (e.g. video/mp4; codecs=...), so accept video/mp4* prefixes.
      // These rules must be live in production via Deploy Storage Rules CI;
      // shipping only in git leaves Edits uploads unauthorized forever.
      allow create: if signedIn() && request.auth.uid == userId &&
          isEditVideoName(fileName) &&
          request.resource.contentType.matches('video/mp4.*') &&
          request.resource.size <= editUploadCeiling();
      // The ceiling has to be enforced on UPDATE as well: the resumable
      // protocol is create-then-update, so a create-only check lets a client
      // start a small object and then grow it past the ceiling. The pipeline
      // downloads the whole source into a 1 GiB function, so an unbounded
      // object is a memory-exhaustion vector, not just a quota one.
      allow update: if signedIn() && request.auth.uid == userId &&
          isEditVideoName(fileName) &&
          (request.resource.contentType.matches('video/mp4.*') ||
              resource.contentType.matches('video/mp4.*')) &&
          request.resource.size <= editUploadCeiling();
      allow delete: if signedIn() && request.auth.uid == userId &&
          isEditVideoName(fileName);
    }

    match /edits-processed/{userId}/{fileName} {
      // Transcoded renditions and the generated cover. Only objects the server
      // has published are readable; the fan_works rule below already gates on
      // status, and this closes the same hole for video.
      allow read: if signedIn() && isEditProcessedName(fileName) &&
          editMediaVisible(userId, fileName);
      allow write: if false;
    }

    function fanWorkDocument(workId) {
      return firestore.get(/databases/(default)/documents/fanWorks/$(workId));
    }

    function fanWorkPublic(workId) {
      return firestore.exists(/databases/(default)/documents/fanWorks/$(workId)) &&
          fanWorkDocument(workId).data.status == 'published' &&
          fanWorkDocument(workId).data.moderationStatus == 'approved';
    }

    match /fan_works/{userId}/{workId}/{fileName} {
      // The declared MIME type must agree with the object name: a `.gif` path
      // carrying `application/pdf` would otherwise be served to the reader as
      // an image. Images cap at 12 MB, PDFs at 50 MB.
      function isPdfName() {
        return fileName.matches('.*[.][pP][dD][fF]$');
      }

      function fanWorkUpload() {
        return (isPdf() && isPdfName() && request.resource.size <= 50 * 1024 * 1024) ||
            (isImage() && !isPdfName() && request.resource.size <= 12 * 1024 * 1024);
      }

      // Images stay directly readable so a viewer can render them with the
      // SDK. A `.pdf` is deliberately NOT readable here: the in-app reader is
      // handed a short-lived V4 signed URL by `getFanWorkDocumentAccess`, and a
      // signed URL is authorized by Cloud Storage rather than by these rules,
      // so removing the rule-based path leaves the reader working while
      // removing the "any signed-in user can fetch the whole PDF" path.
      allow read: if signedIn() &&
          !fileName.matches('.*[.][pP][dD][fF]$') &&
          (request.auth.uid == userId || fanWorkPublic(workId));
      allow create: if signedIn() &&
          request.auth.uid == userId &&
          firestore.exists(/databases/(default)/documents/fanWorks/$(workId)) &&
          fanWorkDocument(workId).data.creatorId == request.auth.uid &&
          fanWorkDocument(workId).data.status == 'draft' &&
          fanWorkUpload() &&
          request.resource.metadata.uploadedBy == request.auth.uid;
      // Resumable putData needs UPDATE after CREATE. Still owner-only, still
      // draft-only, and `uploadedBy` may not be reassigned to another uid.
      allow update: if signedIn() &&
          request.auth.uid == userId &&
          firestore.exists(/databases/(default)/documents/fanWorks/$(workId)) &&
          fanWorkDocument(workId).data.creatorId == request.auth.uid &&
          fanWorkDocument(workId).data.status == 'draft' &&
          fanWorkUpload() &&
          isExistingUploader() && isNewUploader();
      allow delete: if signedIn() && request.auth.uid == userId &&
          firestore.exists(/databases/(default)/documents/fanWorks/$(workId)) &&
          fanWorkDocument(workId).data.creatorId == request.auth.uid;
    }
  }
}