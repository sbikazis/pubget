<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Release builds forbid cleartext. Debug keeps it only so local Firebase
         emulators (http://10.0.2.2:*) remain reachable during development.
         tools:replace resolves the merger conflict with the main manifest's
         usesCleartextTraffic="false" instead of failing assembleDebug. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic"/>
</manifest>
