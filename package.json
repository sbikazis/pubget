{
  "name": "pubget-security-tests",
  "version": "1.0.0",
  "description": "Firebase security rule tests for Pubget",
  "private": true,
  "scripts": {
    "test": "npm run test:rules",
    "test:rules": "firebase emulators:exec --project demo-pubget-security --only firestore,storage \"node --test functions/test/*.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.28.2"
  },
  "dependencies": {
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5",
    "firebase-functions-test": "^3.4.1"
  }
}
