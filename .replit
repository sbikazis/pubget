modules = ["web", "nodejs-20", "java-graalvm22.3", "python-base-3.13"]

[nix]
channel = "stable-25_05"
packages = ["jdk21_headless", "flutter"]

[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080
exposeLocalhost = true

[[ports]]
localPort = 8185
externalPort = 3001

[[ports]]
localPort = 8635
externalPort = 80

[[ports]]
localPort = 8857
externalPort = 3002

[[ports]]
localPort = 8997
externalPort = 3000
