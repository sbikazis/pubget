modules = ["web", "nodejs-20", "java-graalvm22.3", "python-base-3.13"]

[nix]
channel = "stable-25_05"
packages = ["jdk21_headless", "flutter"]

[agent]
expertMode = true

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080
exposeLocalhost = true

[[ports]]
localPort = 8185
externalPort = 3001

[[ports]]
localPort = 8635
externalPort = 80

[[ports]]
localPort = 8857
externalPort = 3002

[[ports]]
localPort = 8997
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flutter build web --pwa-strategy=none && python3 -m http.server 5000 --directory build/web"
waitForPort = 5000
