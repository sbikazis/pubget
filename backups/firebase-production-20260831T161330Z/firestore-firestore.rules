rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // المجموعات - القراءة تبقى عامة باش يبقى الاكتشاف خدام كما في الصور
    match /groups/{groupId} {
      allow read: if true;
      
      allow create: if request.auth != null
                    && request.resource.data.get('name','').size() >= 3
                    && request.resource.data.get('ownerId','') == request.auth.uid
                    && request.resource.data.get('name','') != 'بدون اسم';

      // غير المالك يقدر يبدل أو يمسح
      allow update: if request.auth != null
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.get('name','').size() >= 3;
                    
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      match /members/{memberId} {
        allow read: if true;
        allow create: if request.auth != null && request.auth.uid == memberId;
        allow delete: if request.auth != null && (
          request.auth.uid == memberId || 
          request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId
        );
        allow update: if false;
      }
    }

    match /physical_products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /edits/{editId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uploaderId == request.auth.uid;
      // غير اللي صايب الفيديو يقدر يمسحو
      allow update, delete: if request.auth != null && resource.data.uploaderId == request.auth.uid;
    }

    match /mafia_games/{gameId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && request.resource.data.get('winner', null) == resource.data.get('winner', null)
                    && request.resource.data.get('rewardsDistributed', false) == resource.data.get('rewardsDistributed', false)
                    && request.resource.data.get('historyWritten', false) == resource.data.get('historyWritten', false);
      allow delete: if false;

      match /players/{playerId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == playerId;
        allow update, delete: if request.auth != null && request.auth.uid == playerId;
        match /private/{doc} {
          allow read: if request.auth != null && request.auth.uid == playerId;
          allow create: if request.auth != null && request.auth.uid == playerId
                        && request.resource.data.get('role','') == 'citizen'
                        && request.resource.data.get('team','') == 'citizens';
          allow update: if request.auth != null && request.auth.uid == playerId
                        && request.resource.data.get('role','') == resource.data.get('role','')
                        && request.resource.data.get('team','') == resource.data.get('team','');
          allow delete: if request.auth != null && request.auth.uid == playerId;
        }
      }
      match /night_actions/{actionId} {
        allow read, write: if request.auth != null && exists(/databases/$(database)/documents/mafia_games/$(gameId)/players/$(request.auth.uid));
      }
      match /votes/{voteId} {
        allow read, write: if request.auth != null && exists(/databases/$(database)/documents/mafia_games/$(gameId)/players/$(request.auth.uid));
      }
      match /chat/{messageId} {
        allow read: if request.auth != null && exists(/databases/$(database)/documents/mafia_games/$(gameId)/players/$(request.auth.uid));
        allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
      match /events/{eventId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /mafia_history/{historyId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
      match /user_mafia_history/{document=**} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // سد نهائي - أي collection ما مذكورش الفوق ممنوع
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
